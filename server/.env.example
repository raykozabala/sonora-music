# Sonora Music Server — Variables de entorno
# Copia este archivo como .env solo si lo necesitas (Render no lo usa, ahí se
# configuran en el panel "Environment").

# Puerto del servidor (local). En Render se asigna automáticamente.
PORT=3000

# Modo: "local" para tu computadora, "render" para la nube
SERVER_MODE=local

# URL pública de tu servidor en Render (para que la app se conecte desde
# cualquier lugar). Cámbiala por la que te dé Render al desplegar.
RENDER_URL=https://sonora-music.onrender.com

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sonora.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/rayko/SonoraMusic/service-local.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/rayko/SonoraMusic/server</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/sonora-server.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/sonora-server.err</string>
</dict>
</plist>
